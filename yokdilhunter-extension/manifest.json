{
  "manifest_version": 3,
  "name": "Enesglish",
  "version": "1.0",
  "description": "Seçilen İngilizce kelimeleri Enesglish veritabanına kaydeder.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "128": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://api.dictionaryapi.dev/*",
    "https://corsproxy.io/*",
    "https://api.allorigins.win/*",
    "https://api.datamuse.com/*",
    "https://api.mymemory.translated.net/*",
    "https://en.wiktionary.org/*",
    "https://en.wikipedia.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://tatoeba.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "save-word": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Seçili metni YOKDILHUNTER'a kaydet"
    }
  }
}